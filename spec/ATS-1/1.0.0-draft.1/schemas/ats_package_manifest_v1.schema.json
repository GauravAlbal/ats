{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ats_package_manifest_v1.schema.json",
  "title": "ATS PackageManifestV1",
  "type": "object",
  "required": [
    "schema_version",
    "standard",
    "spec_version",
    "generated_at",
    "hash_algorithm",
    "files"
  ],
  "properties": {
    "schema_version": {
      "const": "ats.package_manifest.v1"
    },
    "standard": {
      "const": "ATS-1"
    },
    "spec_version": {
      "type": "string",
      "minLength": 1
    },
    "generated_at": {
      "$ref": "ats_common_v1.schema.json#/$defs/timestamp"
    },
    "hash_algorithm": {
      "const": "SHA-256"
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "path",
          "bytes",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "$ref": "ats_common_v1.schema.json#/$defs/sha256"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
