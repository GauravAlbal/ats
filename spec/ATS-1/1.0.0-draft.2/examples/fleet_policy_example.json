  "text_policy": {
    "standard": "ATS-1",
    "version": "1.0.0-draft.2",
    "required_for": [
      "architecture",
      "technical_proposal",
      "rfc",
      "implementation_spec",
      "capability_program",
      "implementation_plan",
      "postmortem",
      "diagnostic",
      "forensic_analysis",
      "technical_assessment",
      "acceptance_record",
      "change_control_record"
    ],
    "enforcement": {
      "ir_schema": "required",
      "deterministic_ir_lint": "required",
      "output_trace": "required",
      "deterministic_output_lint": "required",
      "semantic_review": "advisory",
      "p0_preservation": "required",
      "stable_coordinate_preservation": "required"
    },
    "failure_policy": {
