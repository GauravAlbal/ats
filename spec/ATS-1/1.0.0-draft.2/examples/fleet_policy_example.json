  "repository_overrides": [
    {
      "repository": "arq",
      "required_for_additions": [
        "design_note"
      ],
      "required_for_removals": [
        "forensic_analysis"
      ],
      "enforcement_overrides": {
        "semantic_review": "required"
      },
      "receipt_binding": "receipts in arq bind policy_id and the resolved enforcement set",
      "applicability_basis": "repository-level override recorded in the fleet policy registry"
    }
  ]
