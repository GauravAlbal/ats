{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ats_finding_v1.schema.json",
  "title": "ATS TextFindingV1",
  "type": "object",
  "required": [
    "schema_version",
    "finding_id",
    "artifact_id",
    "policy_snapshot_id",
    "rule_id",
    "rule_version",
    "profile",
    "spans",
    "issue_code",
    "summary",
    "severity",
    "detector",
    "applicability",
    "protected_impact",
    "state"
  ],
  "properties": {
    "schema_version": {
      "const": "ats.finding.v1"
    },
    "finding_id": {
      "$ref": "ats_common_v1.schema.json#/$defs/identifier"
    },
    "artifact_id": {
      "$ref": "ats_common_v1.schema.json#/$defs/identifier"
    },
    "policy_snapshot_id": {
      "$ref": "ats_common_v1.schema.json#/$defs/identifier"
    },
    "rule_id": {
      "type": "string",
      "pattern": "^ATS-[A-Z]+-[0-9]{3}$"
    },
    "rule_version": {
      "type": "string"
    },
    "profile": {
      "$ref": "ats_common_v1.schema.json#/$defs/profile"
    },
    "spans": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "ats_common_v1.schema.json#/$defs/span"
      }
    },
    "issue_code": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "evidence_spans": {
      "type": "array",
      "items": {
        "$ref": "ats_common_v1.schema.json#/$defs/span"
      }
    },
    "severity": {
      "enum": [
        "critical",
        "major",
        "minor",
        "info"
      ]
    },
    "detector": {
      "$ref": "ats_common_v1.schema.json#/$defs/detector"
    },
    "applicability": {
      "enum": [
        "applies",
        "does_not_apply",
        "abstain"
      ]
    },
    "abstention_reason": {
      "type": "string"
    },
    "protected_impact": {
      "type": "array",
      "items": {
        "enum": [
          "P0",
          "P1",
          "P2"
        ]
      },
      "uniqueItems": true
    },
    "interpretations": {
      "type": "array",
      "items": {
        "$ref": "ats_common_v1.schema.json#/$defs/interpretation"
      }
    },
    "proposed_repairs": {
      "type": "array",
      "items": {
        "$ref": "ats_common_v1.schema.json#/$defs/repair"
      }
    },
    "state": {
      "enum": [
        "proposed",
        "accepted",
        "rejected",
        "waived",
        "deferred",
        "resolved",
        "unresolved"
      ]
    },
    "adjudication_ref": {
      "type": "string"
    },
    "extensions": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "applicability": {
            "const": "abstain"
          }
        }
      },
      "then": {
        "required": [
          "abstention_reason"
        ]
      }
    }
  ],
  "additionalProperties": false
}
