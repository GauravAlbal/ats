  "sections": [
    {
      "section_id": "requirement",
      "heading": "Receipt re-verification",
      "profiles": [
        "SPECIFY"
      ],
      "claims": [
        {
          "claim_id": "REQ-VERIFY-001",
          "role": "requirement",
          "proposition": "When the verifier accepts a receipt, it MUST re-verify the receipt against the policy snapshot currently in force.",
          "material": true,
          "polarity": "positive",
          "scope": {
            "system": "Arq verifier",
            "authority_domain": "Arq acceptance-policy kernel"
          },
          "force": {
            "deontic": "MUST"
          },
          "status": "asserted",
          "requirement": {
            "requirement_id": "REQ-VERIFY-001",
            "actor": "verifier",
            "deontic": "MUST",
            "action": "re-verify",
            "object": "the receipt against the policy snapshot currently in force",
            "trigger": "when the verifier accepts a receipt",
            "acceptance_criterion_id": "AC-VERIFY-001",
            "acceptance_criterion": "A receipt that fails re-verification against the in-force snapshot is refused with no accepted transition.",
            "source_authority": "Arq acceptance-policy kernel",
            "rationale": "Re-verification binds acceptance to the snapshot currently in force, not the snapshot recorded at authoring time."
          }
        },
        {
          "claim_id": "REQ-VERIFY-002",
          "role": "requirement",
          "proposition": "The verifier MUST refuse a receipt whose re-verification depends on a snapshot that no longer resolves.",
          "material": true,
          "polarity": "positive",
          "scope": {
            "system": "Arq verifier",
            "authority_domain": "Arq acceptance-policy kernel"
          },
          "force": {
            "deontic": "MUST"
          },
          "status": "asserted",
          "requirement": {
            "requirement_id": "REQ-VERIFY-002",
            "actor": "verifier",
            "deontic": "MUST",
            "action": "refuse",
            "object": "a receipt whose re-verification depends on a snapshot that no longer resolves",
            "acceptance_criterion_id": "AC-VERIFY-002",
            "acceptance_criterion": "A fixture with an unresolvable snapshot dependency returns refused_unresolvable_snapshot.",
            "source_authority": "Arq acceptance-policy kernel",
            "rationale": "An unresolvable dependency cannot be evaluated, so acceptance would be unsupported.",
            "semantic_basis": {
              "basis": "DERIVED",
              "rationale": "Follows mechanically from REQ-VERIFY-001 plus the dependency structure of the acceptance kernel."
            }
          },
          "semantic_basis": {
            "basis": "DERIVED",
            "rationale": "The refusal obligation is entailed by the re-verification obligation once the snapshot dependency is established."
          }
        },
        {
          "claim_id": "AC-VERIFY-001",
          "role": "definition",
          "proposition": "Acceptance criterion AC-VERIFY-001: a receipt that fails re-verification against the in-force snapshot is refused with no accepted transition.",
          "material": true,
          "polarity": "positive",
          "status": "asserted"
        },
        {
          "claim_id": "AC-VERIFY-002",
          "role": "definition",
          "proposition": "Acceptance criterion AC-VERIFY-002: a fixture with an unresolvable snapshot dependency returns refused_unresolvable_snapshot.",
          "material": true,
          "polarity": "positive",
          "status": "asserted"
        },
        {
          "claim_id": "DEC-VERIFY-001",
          "role": "judgment",
          "decision_id": "DEC-VERIFY-001",
          "proposition": "The verifier maintains a memoized map from artifact to the snapshot under which it was last verified.",
