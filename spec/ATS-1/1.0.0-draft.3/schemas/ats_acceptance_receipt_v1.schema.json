{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ats_acceptance_receipt_v1.schema.json",
  "title": "ATS TextAcceptanceReceiptV1",
  "type": "object",
  "required": [
    "schema_version",
    "receipt_id",
    "receipt_sha256",
    "standard",
    "spec_version",
    "source_sha256",
    "policy_snapshot_id",
    "policy_snapshot_sha256",
    "implementation",
    "profiles",
    "deterministic_summary",
    "semantic_summary",
    "conformance",
    "adjudicator",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "ats.acceptance_receipt.v1"
    },
    "receipt_id": {
      "type": "string"
    },
    "receipt_sha256": {
      "$ref": "ats_common_v1.schema.json#/$defs/sha256"
    },
    "standard": {
      "const": "ATS-1"
    },
    "spec_version": {
      "type": "string"
    },
    "source_sha256": {
      "$ref": "ats_common_v1.schema.json#/$defs/sha256"
    },
    "output_sha256": {
      "$ref": "ats_common_v1.schema.json#/$defs/sha256"
    },
    "policy_snapshot_id": {
      "type": "string"
    },
    "policy_snapshot_sha256": {
      "$ref": "ats_common_v1.schema.json#/$defs/sha256"
    },
    "implementation": {
      "type": "object",
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "sha256": {
          "$ref": "ats_common_v1.schema.json#/$defs/sha256"
        },
        "parser_version": {
          "type": "string"
        },
        "rule_registry_version": {
          "type": "string"
        },
        "lexicon_version": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "profiles": {
      "type": "array",
      "items": {
        "$ref": "ats_common_v1.schema.json#/$defs/profile"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "deterministic_summary": {
      "type": "object",
      "required": [
        "required_passed",
        "required_failed",
        "required_unavailable"
      ],
      "properties": {
        "required_passed": {
          "type": "integer",
          "minimum": 0
        },
        "required_failed": {
          "type": "integer",
          "minimum": 0
        },
        "required_unavailable": {
          "type": "integer",
          "minimum": 0
        },
        "advisory_findings": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "semantic_summary": {
      "type": "object",
      "required": [
        "proposed",
        "accepted",
        "rejected",
        "waived",
        "unresolved",
        "abstained"
      ],
      "properties": {
        "proposed": {
          "type": "integer",
          "minimum": 0
        },
        "accepted": {
          "type": "integer",
          "minimum": 0
        },
        "rejected": {
          "type": "integer",
          "minimum": 0
        },
        "waived": {
          "type": "integer",
          "minimum": 0
        },
        "unresolved": {
          "type": "integer",
          "minimum": 0
        },
        "abstained": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "finding_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "adjudication_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "preservation_report_id": {
      "type": "string"
    },
    "conformance": {
      "$ref": "ats_common_v1.schema.json#/$defs/conformance_vector"
    },
    "adjudicator": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "$ref": "ats_common_v1.schema.json#/$defs/timestamp"
    },
    "supersedes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "extensions": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
