{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ats_completion_gate_v1.schema.json",
  "title": "ATS CompletionGateV1",
  "description": "A milestone completion gate evaluated against artifacts rather than recollection. Every condition carries one of three statuses, and `unavailable` is structurally prevented from standing in for `met`: an unavailable condition MUST carry an unavailability object naming why it could not be evaluated, and a met or not_met condition MUST carry a null one. A gate that reported a missing artifact as satisfaction would open itself, which is the failure ADR-0002 exists to stop.",
  "type": "object",
  "required": [
    "schema_version",
    "gate_id",
    "record_sha256",
    "generated_at",
    "milestone",
    "conditions",
    "summary"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "ats.completion_gate.v1"
    },
    "gate_id": {
      "$ref": "ats_common_v1.schema.json#/$defs/identifier"
    },
    "record_sha256": {
      "$ref": "ats_common_v1.schema.json#/$defs/sha256"
    },
    "generated_at": {
      "$ref": "ats_common_v1.schema.json#/$defs/timestamp"
    },
    "milestone": {
      "type": "string",
      "minLength": 1
    },
    "conditions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "condition_id",
          "statement",
          "status",
          "unavailability",
          "evidence",
          "detail"
        ],
        "additionalProperties": false,
        "properties": {
          "condition_id": {
            "type": "string",
            "minLength": 1
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "met",
              "not_met",
              "unavailable"
            ]
          },
          "unavailability": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "required": [
                  "code",
                  "reason"
                ],
                "additionalProperties": false,
                "properties": {
                  "code": {
                    "type": "string",
                    "minLength": 1
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            ]
          },
          "evidence": {
            "type": "object"
          },
          "detail": {
            "type": "string",
            "minLength": 1
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "unavailable"
                }
              }
            },
            "then": {
              "properties": {
                "unavailability": {
                  "type": "object"
                }
              },
              "required": [
                "unavailability"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "enum": [
                    "met",
                    "not_met"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "unavailability": {
                  "type": "null"
                }
              }
            }
          }
        ]
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "total",
        "met",
        "not_met",
        "unavailable",
        "open"
      ],
      "additionalProperties": false,
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 1
        },
        "met": {
          "type": "integer",
          "minimum": 0
        },
        "not_met": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unavailable": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "open": {
          "type": "boolean",
          "description": "True only when every condition was evaluated and met."
        }
      }
    }
  }
}
