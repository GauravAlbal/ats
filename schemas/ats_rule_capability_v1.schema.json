{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ats_rule_capability_v1.schema.json",
  "title": "ATS Per-Rule Capability Declaration V1",
  "description": "Repository-local expansion of the normative ats.capability.v1 rules array. For every rule in ats_rules_v1.yaml this declares whether it is implemented, which detector class implements it, whether the implementation can produce conformance evidence, what inputs it requires, what conditions produce UNAVAILABLE, and its known limits.",
  "type": "object",
  "required": [
    "schema_version",
    "implementation_name",
    "implementation_version",
    "ats_version",
    "rules"
  ],
  "properties": {
    "schema_version": { "const": "ats.rule_capability.v1" },
    "implementation_name": { "type": "string", "minLength": 1 },
    "implementation_version": { "type": "string", "minLength": 1 },
    "ats_version": { "type": "string", "minLength": 1 },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/rule_capability" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "rule_capability": {
      "type": "object",
      "required": [
        "rule_id",
        "implemented",
        "surfaces",
        "detector_class",
        "decision_power",
        "produces_conformance_evidence",
        "required_inputs",
        "available_inputs",
        "missing_inputs",
        "blocking_inputs",
        "unavailable_conditions",
        "known_limits"
      ],
      "properties": {
        "rule_id": { "type": "string", "pattern": "^ATS-[A-Z]+-[0-9]{3}$" },
        "implemented": { "type": "boolean" },
        "surfaces": {
          "type": "array",
          "description": "Which linter surfaces evaluate this rule.",
          "items": { "enum": ["ir", "output"] },
          "uniqueItems": true
        },
        "detector_class": { "enum": ["D0", "D1", "D2", "D3", "D4", "none"] },
        "detector_name": { "type": "string" },
        "decision_power": { "enum": ["decides", "detects_violations", "undecidable"] },
        "produces_conformance_evidence": { "type": "boolean" },
        "authority": {
          "enum": ["candidate_only", "proposal_only", "conformance_evidence", "none"]
        },
        "authority_basis_ref": { "type": "string", "minLength": 1 },
        "required_inputs": {
          "type": "array",
          "description": "Copied from the normative rule record.",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "available_inputs": {
          "type": "array",
          "description": "Subset of required_inputs this surface can actually supply.",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "missing_inputs": {
          "type": "array",
          "description": "required_inputs minus available_inputs. Mechanical set difference; recorded even when a substitution covers it.",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "blocking_inputs": {
          "type": "array",
          "description": "The subset of missing_inputs that actually prevents a decision. A detector may only claim decision_power 'decides' when this is empty.",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "input_substitutions": {
          "type": "array",
          "description": "A missing required input that a different, present artifact stands in for on this surface. Every substitution must name the artifact and the spec section that makes it equivalent for the subchecks performed. Undeclared substitution is prohibited.",
          "items": {
            "type": "object",
            "required": ["input", "substituted_by", "spec_ref", "justification"],
            "properties": {
              "input": { "type": "string", "minLength": 1 },
              "substituted_by": { "type": "string", "minLength": 1 },
              "spec_ref": { "type": "string", "minLength": 1 },
              "justification": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          }
        },
        "subchecks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["subcheck_id", "decides", "spec_ref", "description"],
            "properties": {
              "subcheck_id": { "type": "string", "minLength": 1 },
              "decides": { "type": "boolean" },
              "spec_ref": { "type": "string", "minLength": 1 },
              "vocabulary_source": {
                "type": "string",
                "description": "Where any matched term list comes from; a detector MUST NOT invent one."
              },
              "description": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          }
        },
        "unavailable_conditions": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "known_limits": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "produces_conformance_evidence": { "const": true } },
            "required": ["produces_conformance_evidence"]
          },
          "then": { "required": ["authority_basis_ref", "detector_name"] }
        },
        {
          "if": {
            "properties": { "implemented": { "const": false } },
            "required": ["implemented"]
          },
          "then": {
            "properties": {
              "decision_power": { "const": "undecidable" },
              "produces_conformance_evidence": { "const": false }
            }
          }
        }
      ],
      "additionalProperties": false
    }
  }
}
