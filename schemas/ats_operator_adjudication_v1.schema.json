{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ats_operator_adjudication_v1.schema.json",
  "title": "ATS OperatorAdjudicationV1",
  "description": "One operator adjudication row: either the source-only judgment (pass A) or the disagreement review (pass B). Rows are append-only and per-stage immutable; a changed decision after seeing the arguments lives in pass B beside the pass-A judgment it revises, never over it. The adjudicator must be a human identity: gold is operator-authored, and a third model vote would measure another correlated interpretation of the rubric rather than the standard. Disposition (what the text is) and diagnosis (why the instruments diverged) are separate fields so neither can stand in for the other.",
  "type": "object",
  "required": [
    "schema_version",
    "record_sha256",
    "unit_id",
    "stage",
    "adjudicator",
    "rationale",
    "recorded_at"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "ats.operator_adjudication.v1"
    },
    "record_sha256": {
      "$ref": "ats_common_v1.schema.json#/$defs/sha256"
    },
    "unit_id": {
      "$ref": "ats_common_v1.schema.json#/$defs/identifier"
    },
    "stage": {
      "enum": [
        "source_only",
        "disagreement_review"
      ]
    },
    "adjudicator": {
      "type": "object",
      "required": [
        "id",
        "kind"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "const": "human"
        }
      }
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    },
    "recorded_at": {
      "$ref": "ats_common_v1.schema.json#/$defs/timestamp"
    },
    "disposition": {
      "enum": [
        "conforming",
        "violation",
        "near_miss",
        "hard_negative",
        "exception",
        "ambiguous_by_design",
        "insufficient_context",
        "excluded",
        "SPECIFY",
        "ASSESS",
        "mixed",
        "reserved_profile",
        "not_applicable",
        "insufficient_context"
      ]
    },
    "determinacy": {
      "enum": [
        "yes",
        "no_multiple_permitted_readings",
        "no_missing_context",
        "no_missing_policy_input"
      ]
    },
    "missing_context": {
      "type": "array",
      "items": {
        "enum": [
          "preceding_sentence",
          "following_sentence",
          "full_paragraph",
          "enclosing_list",
          "heading_path",
          "definition",
          "referenced_section",
          "table_or_schema",
          "source_attribution",
          "policy_snapshot",
          "repository_convention",
          "revision_context",
          "external_artifact"
        ]
      }
    },
    "evidence_offsets": {
      "type": "array",
      "items": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "items": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "final_disposition": {
      "enum": [
        "conforming",
        "violation",
        "near_miss",
        "hard_negative",
        "exception",
        "ambiguous_by_design",
        "insufficient_context",
        "excluded",
        "SPECIFY",
        "ASSESS",
        "mixed",
        "reserved_profile",
        "not_applicable",
        "insufficient_context"
      ]
    },
    "decision_changed": {
      "type": "boolean"
    },
    "system_diagnosis": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "code",
          "primary"
        ],
        "additionalProperties": false,
        "properties": {
          "code": {
            "enum": [
              "annotator_error",
              "annotation_guide_defect",
              "context_bundle_defect",
              "candidate_mining_defect",
              "profile_boundary_defect",
              "rule_wording_defect",
              "rule_boundary_defect",
              "schema_defect",
              "multiple_valid_interpretations",
              "source_ambiguity",
              "no_system_defect"
            ]
          },
          "primary": {
            "type": "boolean"
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "competent_reader_could_reach_rejected": {
      "type": "boolean"
    },
    "ats_num_002": {
      "type": "object",
      "required": [
        "boundary_required",
        "inclusivity_material",
        "boundary_recoverable_from_operator",
        "boundary_defined_elsewhere_in_scope",
        "text_is_requirement_observation_or_explanation",
        "uncertainty_creates_implementation_divergence"
      ],
      "additionalProperties": false,
      "properties": {
        "boundary_required": {
          "type": "string",
          "minLength": 1
        },
        "inclusivity_material": {
          "type": "string",
          "minLength": 1
        },
        "boundary_recoverable_from_operator": {
          "type": "string",
          "minLength": 1
        },
        "boundary_defined_elsewhere_in_scope": {
          "type": "string",
          "minLength": 1
        },
        "text_is_requirement_observation_or_explanation": {
          "type": "string",
          "minLength": 1
        },
        "uncertainty_creates_implementation_divergence": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "requirement_forms": {
      "type": "array",
      "items": {
        "enum": [
          "canonical_modal_requirement",
          "declarative_invariant",
          "acceptance_criterion",
          "prohibition",
          "permission",
          "capability_boundary",
          "conditional_obligation",
          "table_encoded_requirement",
          "schema_encoded_constraint",
          "distributed_requirement_block"
        ]
      }
    },
    "prior_exposure": {
      "description": "A blinding breach that preceded this judgment, recorded structurally so scoring and the gate can filter or weight the unit rather than discovering the fact in prose. Absent when no breach occurred; a judgment made after exposure is still gold, but it is gold with a named caveat.",
      "type": "object",
      "required": [
        "code",
        "detail"
      ],
      "additionalProperties": false,
      "properties": {
        "code": {
          "enum": [
            "instrument_verdict_summaries_shown",
            "instrument_behaviour_discussed_in_review"
          ]
        },
        "detail": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "stage": {
            "const": "source_only"
          }
        }
      },
      "then": {
        "required": [
          "disposition",
          "determinacy"
        ],
        "properties": {
          "final_disposition": false,
          "system_diagnosis": false,
          "competent_reader_could_reach_rejected": false,
          "decision_changed": false
        }
      }
    },
    {
      "if": {
        "properties": {
          "stage": {
            "const": "disagreement_review"
          }
        }
      },
      "then": {
        "required": [
          "final_disposition",
          "system_diagnosis",
          "decision_changed"
        ],
        "properties": {
          "disposition": false,
          "determinacy": false
        }
      }
    }
  ]
}
