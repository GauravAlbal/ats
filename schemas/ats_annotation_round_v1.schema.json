{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ats_annotation_round_v1.schema.json",
  "title": "ATS Annotation Round V1",
  "description": "One round of independent blind annotation over a frozen sampling frame. The round selects from the frame and never alters it: a frame that grew or was re-flagged after judgments existed could no longer be the thing an agreement figure was measured against. Each pass is frozen with its own content hash before any adjudication begins, so a later disagreement cannot be resolved by quietly revising an earlier judgment (spec Sections 17.9, 17.11).",
  "type": "object",
  "required": [
    "schema_version",
    "round_id",
    "generated_at",
    "frame",
    "policy",
    "annotators",
    "strata",
    "selection",
    "blinding",
    "passes"
  ],
  "properties": {
    "schema_version": {
      "const": "ats.annotation_round.v1"
    },
    "round_id": {
      "$ref": "ats_common_v1.schema.json#/$defs/identifier"
    },
    "record_sha256": {
      "$ref": "ats_common_v1.schema.json#/$defs/sha256"
    },
    "generated_at": {
      "$ref": "ats_common_v1.schema.json#/$defs/timestamp"
    },
    "frame": {
      "description": "The frozen frame this round draws from, bound by content address. A round whose frame hash no longer matches the frame on disk is a round measured against something that no longer exists.",
      "type": "object",
      "required": [
        "frame_id",
        "record_sha256",
        "selection_count"
      ],
      "properties": {
        "frame_id": {
          "$ref": "ats_common_v1.schema.json#/$defs/identifier"
        },
        "record_sha256": {
          "$ref": "ats_common_v1.schema.json#/$defs/sha256"
        },
        "selection_count": {
          "type": "integer",
          "minimum": 1
        },
        "supersedes_frame_flag": {
          "description": "Whether this round's selection replaces a double-annotation flag carried on the frame. Recorded because two different answers to 'which bundles get two judgments' must not both look authoritative.",
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "policy": {
      "type": "object",
      "required": [
        "seed",
        "target_size",
        "judgments_per_example"
      ],
      "properties": {
        "seed": {
          "type": "integer"
        },
        "target_size": {
          "type": "integer",
          "minimum": 1
        },
        "judgments_per_example": {
          "type": "integer",
          "minimum": 1
        },
        "adjudication_opens_after": {
          "description": "The rule that gates adjudication. Both passes complete and frozen, always: adjudicating incrementally lets an early disagreement steer the judgments that follow it.",
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "annotators": {
      "description": "Who judged, and what they are. `kind: llm` is not a lesser form of `human`; it measures something different, and a report that blurs them reports human inter-rater reliability it does not have.",
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": [
          "annotator_id",
          "kind"
        ],
        "properties": {
          "annotator_id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "llm",
              "human",
              "unknown"
            ]
          },
          "model": {
            "type": "string"
          },
          "prompt_id": {
            "type": "string"
          },
          "prompt_sha256": {
            "$ref": "ats_common_v1.schema.json#/$defs/sha256"
          }
        },
        "additionalProperties": false
      }
    },
    "strata": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "stratum",
          "target",
          "selected"
        ],
        "properties": {
          "stratum": {
            "type": "string",
            "minLength": 1
          },
          "target": {
            "type": "integer",
            "minimum": 0
          },
          "selected": {
            "type": "integer",
            "minimum": 0
          },
          "pool": {
            "type": "integer",
            "minimum": 0
          },
          "shortfall_reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "selection": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "bundle_id",
          "stratum",
          "split_group",
          "rule_ids"
        ],
        "properties": {
          "bundle_id": {
            "$ref": "ats_common_v1.schema.json#/$defs/identifier"
          },
          "source_artifact_id": {
            "$ref": "ats_common_v1.schema.json#/$defs/identifier"
          },
          "repository": {
            "type": "string"
          },
          "stratum": {
            "type": "string",
            "minLength": 1
          },
          "split_group": {
            "type": "string",
            "minLength": 1
          },
          "rule_ids": {
            "description": "The rules this bundle is judged against, one judgment each. A candidate rule is not a prediction that the rule is violated.",
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "additionalProperties": false
      }
    },
    "blinding": {
      "type": "object",
      "required": [
        "withheld_until_submission",
        "rationale"
      ],
      "properties": {
        "withheld_until_submission": {
          "description": "Fields an annotator may not see before submitting. Why a bundle was sampled is legitimate context afterwards and an anchor beforehand.",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "passes": {
      "description": "One entry per annotator pass. A pass is frozen by the content hash of its judgment file; adjudication may not begin until every pass here is frozen.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "annotator_id",
          "state",
          "judgment_count"
        ],
        "properties": {
          "annotator_id": {
            "type": "string",
            "minLength": 1
          },
          "state": {
            "enum": [
              "open",
              "frozen",
              "unavailable"
            ]
          },
          "judgment_count": {
            "type": "integer",
            "minimum": 0
          },
          "path": {
            "type": "string"
          },
          "judgments_sha256": {
            "$ref": "ats_common_v1.schema.json#/$defs/sha256"
          },
          "detail": {
            "type": "string"
          },
          "decline_count": {
            "description": "Items this pass answered by reporting the rule inapplicable. Recorded separately from judgment_count because AG-19 step 2 makes a decline a finding about scope, not a missing judgment.",
            "type": "integer",
            "minimum": 0
          },
          "declines_path": {
            "type": "string",
            "minLength": 1
          },
          "declines_sha256": {
            "$ref": "ats_common_v1.schema.json#/$defs/sha256"
          },
          "universe": {
            "description": "Judgments plus declines: the item set this pass actually answered. Two passes must agree on this before adjudication, even when they disagree about how many of those items carried an applicable rule.",
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": false
      }
    },
    "supersedes": {
      "description": "The round this one replaces when an earlier frame was found defective. The sealed body records the supersession so the correction is content-addressed rather than maintained as an external annotation. Superseded judgments remain available in the owning evidence store rather than being silently rewritten.",
      "type": "object",
      "required": [
        "round_id",
        "frame_id",
        "reason"
      ],
      "properties": {
        "round_id": {
          "$ref": "ats_common_v1.schema.json#/$defs/identifier"
        },
        "frame_id": {
          "$ref": "ats_common_v1.schema.json#/$defs/identifier"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "judgments_retained_at": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
