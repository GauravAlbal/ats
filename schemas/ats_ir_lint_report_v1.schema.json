{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ats_ir_lint_report_v1.schema.json",
  "title": "ATS IR Lint Report V1",
  "description": "Deterministic result of `ats ir lint`. Every active rule receives an explicit result and every structural check is named, so a missing check is visible rather than absent.",
  "type": "object",
  "required": [
    "schema_version",
    "report_id",
    "artifact_id",
    "ir_sha256",
    "spec_version",
    "policy_snapshot_id",
    "policy_sha256",
    "profiles",
    "implementation",
    "structural_checks",
    "rule_results",
    "findings",
    "summary",
    "conformance",
    "created_at"
  ],
  "properties": {
    "schema_version": { "const": "ats.ir_lint_report.v1" },
    "report_id": { "$ref": "ats_common_v1.schema.json#/$defs/identifier" },
    "report_sha256": { "$ref": "ats_common_v1.schema.json#/$defs/sha256" },
    "artifact_id": { "$ref": "ats_common_v1.schema.json#/$defs/identifier" },
    "ir_sha256": { "$ref": "ats_common_v1.schema.json#/$defs/sha256" },
    "source_content_sha256": { "$ref": "ats_common_v1.schema.json#/$defs/sha256" },
    "spec_version": { "type": "string", "minLength": 1 },
    "policy_snapshot_id": { "type": "string", "minLength": 1 },
    "policy_sha256": { "$ref": "ats_common_v1.schema.json#/$defs/sha256" },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "ats_common_v1.schema.json#/$defs/profile" }
    },
    "unsupported_profiles": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "implementation": {
      "type": "object",
      "required": ["name", "version", "rule_registry_version", "lexicon_version"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "rule_registry_version": { "type": "string", "minLength": 1 },
        "lexicon_version": { "type": "string", "minLength": 1 },
        "schema_set_sha256": { "$ref": "ats_common_v1.schema.json#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "structural_checks": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/check_result" }
    },
    "rule_results": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "ats_rule_result_v1.schema.json" }
    },
    "findings": {
      "type": "array",
      "items": { "$ref": "ats_finding_v1.schema.json" }
    },
    "policy_conflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["rule_id", "profiles", "states", "detail"],
        "properties": {
          "rule_id": { "type": "string" },
          "profiles": { "type": "array", "items": { "type": "string" } },
          "states": { "type": "array", "items": { "type": "string" } },
          "detail": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "ignored_policy_directives": {
      "type": "array",
      "description": "Policy directives refused during resolution, retained so a declined change is visible.",
      "items": {
        "type": "object",
        "required": ["rule_id", "profile", "directive", "attempted_state", "effective_state", "reason"],
        "properties": {
          "rule_id": { "type": "string" },
          "profile": { "type": "string" },
          "directive": { "type": "string" },
          "attempted_state": { "type": "string" },
          "effective_state": { "type": "string" },
          "reason": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "rules_total",
        "by_status",
        "required_failed",
        "required_unavailable",
        "required_review_required",
        "advisory_findings"
      ],
      "properties": {
        "rules_total": { "type": "integer", "minimum": 0 },
        "by_status": {
          "type": "object",
          "required": ["PASS", "FAIL", "UNAVAILABLE", "NOT_APPLICABLE", "REVIEW_REQUIRED"],
          "properties": {
            "PASS": { "type": "integer", "minimum": 0 },
            "FAIL": { "type": "integer", "minimum": 0 },
            "UNAVAILABLE": { "type": "integer", "minimum": 0 },
            "NOT_APPLICABLE": { "type": "integer", "minimum": 0 },
            "REVIEW_REQUIRED": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        },
        "required_failed": { "type": "integer", "minimum": 0 },
        "required_unavailable": { "type": "integer", "minimum": 0 },
        "required_review_required": { "type": "integer", "minimum": 0 },
        "advisory_findings": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "conformance": { "$ref": "ats_common_v1.schema.json#/$defs/conformance_vector" },
    "conformance_rationale": {
      "type": "object",
      "description": "Why each dimension holds the status it holds. A dimension MUST NOT be PASS without a rationale naming the evidence.",
      "required": ["mechanical", "profile", "semantic_review", "preservation", "forecast_calibration"],
      "additionalProperties": false,
      "properties": {
        "mechanical": { "type": "string", "minLength": 1 },
        "profile": { "type": "string", "minLength": 1 },
        "semantic_review": { "type": "string", "minLength": 1 },
        "preservation": { "type": "string", "minLength": 1 },
        "forecast_calibration": { "type": "string", "minLength": 1 }
      }
    },
    "created_at": { "$ref": "ats_common_v1.schema.json#/$defs/timestamp" }
  },
  "additionalProperties": false,
  "$defs": {
    "check_result": {
      "type": "object",
      "required": ["check_id", "title", "status", "required"],
      "properties": {
        "check_id": { "type": "string", "pattern": "^(IR|OUT)-[A-Z0-9-]+$" },
        "title": { "type": "string", "minLength": 1 },
        "status": {
          "enum": ["PASS", "FAIL", "UNAVAILABLE", "NOT_APPLICABLE", "REVIEW_REQUIRED"]
        },
        "required": { "type": "boolean" },
        "detail": { "type": "string" },
        "spec_ref": { "type": "string" },
        "finding_ids": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      },
      "additionalProperties": false
    }
  }
}
